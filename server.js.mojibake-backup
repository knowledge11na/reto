        console.log(
          '[hawk:play-card] ALL SUBMITTED',
          roomId
        );

        /*
         * 蜈ｨ蜩｡蜈ｬ髢九・
         */
        const result =
          hawkResolveRound(
            game
          );

        /*
         * 螻･豁ｴ繧剃ｿ晏ｭ倥・
