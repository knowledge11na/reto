// 迴ｾ蝨ｨ縺ｮ繝励Ξ繧､繝､繝ｼ荳隕ｧ
// ============================================================

function hawkGetPlayers(
  game
) {
  const room =
    freeRooms.get(
      game.roomId
    );

  if (!room) {
    return [];
  }

  if (
    room.players instanceof Map
  ) {
    return Array.from(
      room.players.values()
    );
  }

  if (
    Array.isArray(
      room.players
    )
  ) {
    return room.players;
  }

  return [];
}


// ============================================================
// 迴ｾ蝨ｨ縺ｮ蠕礼せ
// ============================================================

function hawkGetScores(
  game
) {
  const players =
    hawkGetPlayers(
      game
    );

  return players.map(
    (player) => ({
      socketId:
        player.socketId,

      name:
        player.name ||
        '繝励Ξ繧､繝､繝ｼ',

      score:
        Number(
          game.scores[
            player.socketId
          ] ?? 0
        ),
    })
  );
}


