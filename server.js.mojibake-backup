        game.played[
          playerSocketId
        ] =
          cardId;

        console.log(
          '[hawk:play-card] SAVED',
          {
            roomId,
            playerSocketId,
            cardId,
            played:
              game.played,
          }
        );

        /*
         * 閾ｪ蛻・・谿九ｊ謇区惆繧呈峩譁ｰ縲・
