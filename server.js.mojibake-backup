function extraPokerNormalizeAnswer(
  value
) {
  return String(
    value ?? ''
  )
    .normalize('NFKC')
    .replace(
      /\s+/g,
      ''
    )
    .toLowerCase()
    .trim();
}


// ============================================================
// 豁｣隗｣蛻､螳・
// ============================================================

function extraPokerIsCorrectAnswer(
  game,
  answer
) {
  if (
    !game.character
  ) {
    return false;
  }

  const normalized =
    extraPokerNormalizeAnswer(
      answer
    );

  if (
    !normalized
  ) {
    return false;
  }

  const rawName =
    String(
      game.character.name
    );

  const candidates = [];

  // 蜈・・蜷榊燕縺昴・繧ゅ・
  candidates.push(
    rawName
  );

  // 縲娯雷笳具ｼ遺無笆ｳ・峨阪・蝣ｴ蜷・
  // 繝ｻ笳銀雷・遺無笆ｳ・・
  // 繝ｻ笳銀雷
  // 繝ｻ笆ｳ笆ｳ
  // 縺ｮ縺吶∋縺ｦ繧呈ｭ｣隗｣蛟呵｣懊↓縺吶ｋ
  const bracketMatch =
    rawName.match(
      /^(.*?)[・・]([^・・]+)[・・](.*)$/
    );

  if (
    bracketMatch
  ) {
    const before =
      bracketMatch[1];

    const inside =
      bracketMatch[2];

    const after =
      bracketMatch[3];

    // 諡ｬ蠑ｧ繧医ｊ蜑・
    if (
      before.trim()
    ) {
      candidates.push(
        before
      );
    }

    // 諡ｬ蠑ｧ縺ｮ荳ｭ
    if (
      inside.trim()
    ) {
      candidates.push(
        inside
      );
    }

    // 諡ｬ蠑ｧ繧医ｊ蠕後ｍ縺ｫ譁・ｭ励′縺ゅｋ蝣ｴ蜷・
    if (
      after.trim()
    ) {
      candidates.push(
        after
      );
    }
  }

  return candidates.some(
    (candidate) =>
      extraPokerNormalizeAnswer(
        candidate
      ) ===
      normalized
  );
}

