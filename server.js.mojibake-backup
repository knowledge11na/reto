    // TURN NEXT
    // ========================================================

socket.on(
  'extra-poker:next-turn',
  async (payload) => {
    const roomId =
      String(
        payload?.roomId ||
          ''
      )
        .replace(
          /\D/g,
          ''
        )
        .slice(
          0,
          4
        );

    const game =
      extraPokerGames.get(
        roomId
      );

    const room =
      freeRooms.get(
        roomId
      );

    if (
      !game ||
      !room
    ) {
      return;
    }

    if (
      room.hostSocketId !==
      socket.id
    ) {
      socket.emit(
        'extra-poker:error',
        {
          message:
            '谺｡縺ｮ繧ｿ繝ｼ繝ｳ縺ｸ騾ｲ繧√ｋ縺ｮ縺ｯ驛ｨ螻倶ｸｻ縺ｧ縺吶・,
        }
      );

      return;
    }

    if (
      game.phase !==
      'turn-result'
    ) {
      return;
    }

    const players =
      extraPokerGetActivePlayers(
        game
      );

    if (
      players.length <= 1
    ) {
      extraPokerFinishGame(
        game
      );

      return;
    }

    /*
     * ========================================================
     * 谺｡縺ｮ縲悟撫鬘後阪・繧ｹ繧ｿ繝ｼ繝医・繝ｬ繧､繝､繝ｼ繧呈ｱｺ繧√ｋ
     *
     * 蜷後§蝠城｡後・騾比ｸｭ縺ｧ縺ｯ螟画峩縺励↑縺・・
     * turn-result 竊・谺｡縺ｮ蝠城｡後√↓縺ｪ縺｣縺溽椪髢薙□縺・
     * 1莠ｺ縺壹▽繧ｹ繧ｿ繝ｼ繝井ｽ咲ｽｮ繧帝ｲ繧√ｋ縲・
     * ========================================================
     */

    const currentStartId =
      game.turnStartPlayerId;

    const nextStartId =
      extraPokerNextPlayer(
        game,
        currentStartId
      );

    /*
     * 繝ｩ繧ｦ繝ｳ繝牙愛螳・
     *
     * 2莠ｺ縺ｪ繧・
     * 蝠城｡・ A
     * 蝠城｡・ B
     * 縺ｧ1繝ｩ繧ｦ繝ｳ繝臥ｵゆｺ・・
     */
    const turnCount =
      game.turnNumber;

    const expectedTurns =
      Math.max(
        2,
        players.length
      );

    if (
      turnCount %
        expectedTurns ===
      0
    ) {
      game.round +=
        1;

      if (
        game.round >
        game.settings.rounds
      ) {
        extraPokerFinishGame(
          game
        );

        return;
      }
    }

    /*
     * 谺｡縺ｮ蝠城｡後ｒ髢句ｧ九・
     *
     * 縺薙％縺ｧ縺縺・nextStartId 繧呈ｸ｡縺吶・
     */
    await extraPokerStartTurn(
      game,
      nextStartId
    );
  }
);

    // ========================================================
    // DISCONNECT
    // ========================================================

    socket.on(
      'disconnect',
      () => {
        for (
          const [
            roomId,
            game,
          ] of extraPokerGames
        ) {
          const room =
            freeRooms.get(
              roomId
            );

          if (!room) {
            extraPokerGames.delete(
              roomId
            );

            continue;
          }

          const stillPlayer =
            room.players instanceof Map
              ? Array.from(
                  room.players.values()
                ).some(
                  (player) =>
                    player.socketId ===
                    socket.id
                )
              : Array.isArray(
                  room.players
                )
                ? room.players.some(
                    (player) =>
                      player.socketId ===
                      socket.id
                  )
                : false;

          if (
            !stillPlayer
          ) {
            continue;
          }

          if (
            game.phase ===
            'setup'
          ) {
            extraPokerBroadcastState(
              game
            );

            continue;
          }

          extraPokerBroadcastState(
            game
          );
        }
      }
    );
  }
);


