            socket.emit(
              'extra-poker:error',
              {
                message:
                  '蝗樒ｭ斐ｒ驕ｸ謚槭＠縺溷ｾ後・縲∝屓遲斐°繝輔か繝ｼ繝ｫ繝峨・縺ｿ縺ｧ縺吶・,
              }
            );

            return;
          }

          if (
            !Number.isInteger(
              requestedBet
            ) ||
            requestedBet % 100 !== 0
          ) {
            socket.emit(
              'extra-poker:error',
              {
                message:
                  '繝吶ャ繝医・100蛻ｻ縺ｿ縺ｧ縺吶・,
