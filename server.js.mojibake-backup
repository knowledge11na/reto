        const playerSocketId =
          player.socketId;

        // ======================================================
        // 縺薙・繝ｩ繧ｦ繝ｳ繝峨〒縺吶〒縺ｫ繧ｫ繝ｼ繝峨ｒ蜃ｺ縺励※縺・ｋ縺狗｢ｺ隱・
        // 窶ｻ Extra Poker 縺ｮ蜃ｦ逅・・菴ｿ繧上↑縺・
        // ======================================================

        if (
          game.played &&
          game.played[playerSocketId]
        ) {
          socket.emit(
            'hawk:error',
            {
              message:
                '縺薙・繝ｩ繧ｦ繝ｳ繝峨〒縺ｯ譌｢縺ｫ繧ｫ繝ｼ繝峨ｒ蜃ｺ縺励※縺・∪縺吶・,
            }
          );

          return;
        }

        /*
         * 繝励Ξ繧､繝､繝ｼ譛ｬ莠ｺ縺ｮSocket ID縺ｧ謇区惆繧貞叙蠕励・
         */
        const hand =
          game.hands[
            playerSocketId
          ];

        if (
          !Array.isArray(hand)
        ) {
          socket.emit(
            'hawk:error',
            {
              message:
                '謇区惆縺瑚ｦ九▽縺九ｊ縺ｾ縺帙ｓ縲・,
            }
          );

          return;
        }

        if (
          !hand.includes(
            cardId
          )
        ) {
          socket.emit(
            'hawk:error',
            {
              message:
                '縺昴・繧ｫ繝ｼ繝峨・迴ｾ蝨ｨ縺ｮ謇区惆縺ｫ縺ゅｊ縺ｾ縺帙ｓ縲・,
            }
          );

          return;
        }

        /*
         * 謇区惆縺九ｉ蜑企勁縲・
         */
        game.hands[
          playerSocketId
        ] =
          hand.filter(
            (id) =>
              id !==
              cardId
          );

        /*
         * 蝣ｴ縺ｫ蜃ｺ縺励◆繧ｫ繝ｼ繝峨ｒ險倬鹸縲・
