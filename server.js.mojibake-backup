              'extra-poker:error',
              {
                message:
                  '謖√▲縺ｦ縺・ｋ繝√ャ繝励ｒ雜・∴縺ｦ繝ｬ繧､繧ｺ縺ｧ縺阪∪縺帙ｓ縲・,
              }
            );

            return;
          }

          const success =
            extraPokerPutToPot(
              game,
              playerSocketId,
              need
            );

          if (!success) {
            socket.emit(
              'extra-poker:error',
              {
                message:
                  '繝吶ャ繝亥・逅・↓螟ｱ謨励＠縺ｾ縺励◆縲・,
              }
            );

            return;
          }

          /*
           * 譛鬮倬｡阪ｒ譖ｴ譁ｰ縲・
           */
          game.currentBet =
            requestedBet;

          /*
           * ====================================================
           * 縺薙％縺碁壼ｸｸ繝昴・繧ｫ繝ｼ蝙九Ξ繧､繧ｺ縺ｮ驥崎ｦ・Κ蛻・
           * ====================================================
           *
           * 繝ｬ繧､繧ｺ縺励◆譛ｬ莠ｺ縺縺題｡悟虚貂医∩縲・
           *
           * 縺昴ｌ莉･螟悶・蜈ｨ蜩｡縺ｯ
           * 縲梧眠縺励＞譛鬮倬｡阪↓蜷医ｏ縺帙ｋ縲・
           * 蠢・ｦ√′縺ゅｋ縺溘ａ譛ｪ陦悟虚縺ｫ謌ｻ縺吶・
           *
           * 縺薙ｌ縺ｫ繧医▲縺ｦ
           *
           * A 繝ｬ繧､繧ｺ300
           * 竊・
           * B
           * 竊・
           * C
           * 竊・
           * D
           *
           * 縺ｨ縺・≧譁ｰ縺励＞荳蜻ｨ縺檎匱逕溘☆繧九・
           */
          for (
            const socketId of
              game.cycleActors
          ) {
            game.cycleActed[
              socketId
            ] =
              socketId ===
              playerSocketId;
          }

          game.lastAction = {
            playerId:
              playerSocketId,

            playerName:
              player.name ||
              '繝励Ξ繧､繝､繝ｼ',

            type:
              'raise',

            amount:
              requestedBet,
          };

          /*
           * 繝ｬ繧､繧ｺ縺励◆譛ｬ莠ｺ莉･螟悶・
           * 谺｡縺ｮ繝励Ξ繧､繝､繝ｼ縺ｸ縲・
           */
          const canAdvance =
            extraPokerAdvanceActor(
              game
            );

          /*
           * 繝ｬ繧､繧ｺ逶ｴ蠕後・
           * 莉悶・繝励Ξ繧､繝､繝ｼ縺後∪縺
           * 譁ｰ縺励＞鬘阪↓蟇ｾ蠢懊＠縺ｦ縺・↑縺・・縺ｧ縲・
           * 騾壼ｸｸ縺薙％縺ｧ縺ｯfalse縺ｫ縺ｪ繧峨↑縺・・
           *
           * 荳・ｸ2莠ｺ莉･荳翫′閼ｱ關ｽ縺励※
           * 蜈ｨ蜩｡謠・▲縺溷ｴ蜷医□縺醍ｵゆｺ・・
           */
          if (
            extraPokerCycleComplete(
              game
            )
          ) {
            await extraPokerFinishCycle(
              game
            );

            return;
          }

          if (
            canAdvance
          ) {
            extraPokerBroadcastState(
              game
            );
          }

          return;
        }


        // ======================================================
        // CALL
        // ======================================================

        if (
          action ===
          'call'
        ) {
          if (
            game.answerLocked[
              playerSocketId
            ]
          ) {
            socket.emit(
              'extra-poker:error',
              {
                message:
                  '蝗樒ｭ斐ｒ驕ｸ謚槭＠縺溷ｾ後・縲∝屓遲斐°繝輔か繝ｼ繝ｫ繝峨・縺ｿ縺ｧ縺吶・,
              }
            );

            return;
          }

          const target =
            game.currentBet;

          const need =
            Math.max(
              0,
              target -
                currentContribution
            );

          if (
            need >
            chips
          ) {
            socket.emit(
              'extra-poker:error',
              {
                message:
                  '迴ｾ蝨ｨ縺ｮ譛鬮倬｡阪∪縺ｧ繧ｳ繝ｼ繝ｫ縺吶ｋ繝√ャ繝励′縺ゅｊ縺ｾ縺帙ｓ縲・,
              }
            );

            return;
          }

          if (
            need > 0
          ) {
            const success =
              extraPokerPutToPot(
                game,
                playerSocketId,
                need
              );

            if (!success) {
              socket.emit(
                'extra-poker:error',
                {
                  message:
                    '繝吶ャ繝亥・逅・↓螟ｱ謨励＠縺ｾ縺励◆縲・,
                }
              );

              return;
            }
          }

          game.cycleActed[
            playerSocketId
          ] = true;

          game.lastAction = {
            playerId:
              playerSocketId,

            playerName:
              player.name ||
              '繝励Ξ繧､繝､繝ｼ',

            type:
              'call',

            amount:
              target,
          };

          const canAdvance =
            extraPokerAdvanceActor(
              game
            );

          if (
            extraPokerCycleComplete(
              game
            )
          ) {
            await extraPokerFinishCycle(
              game
            );

            return;
          }

          if (
            canAdvance
          ) {
            extraPokerBroadcastState(
              game
            );
          }

          return;
        }


        // ======================================================
        // FOLD
        // ======================================================

        if (
          action ===
          'fold'
        ) {
          game.folded[
            playerSocketId
          ] = true;

          game.answerLost[
            playerSocketId
          ] = true;

          game.answerLocked[
            playerSocketId
          ] = false;

          game.answerSubmitted[
            playerSocketId
          ] = false;

          delete game.answers[
            playerSocketId
          ];

          game.cycleActed[
            playerSocketId
          ] = true;

          game.lastAction = {
            playerId:
              playerSocketId,

            playerName:
              player.name ||
              '繝励Ξ繧､繝､繝ｼ',

            type:
              'fold',

            amount:
              0,
          };

          const remaining =
            extraPokerGetActionPlayers(
              game
            );

          if (
            remaining.length ===
            1
          ) {
            await extraPokerEndTurn(
              game,
              '莉悶・蜈ｨ蜩｡縺後ヵ繧ｩ繝ｼ繝ｫ繝峨＠縺ｾ縺励◆縲・,
              [
                remaining[0]
                  .socketId,
              ]
            );

            return;
          }

          const canAdvance =
            extraPokerAdvanceActor(
              game
            );

          if (
            extraPokerCycleComplete(
              game
            )
          ) {
            await extraPokerFinishCycle(
              game
            );

            return;
          }

          if (
            canAdvance
          ) {
            extraPokerBroadcastState(
              game
            );
          }

          return;
        }


        socket.emit(
          'extra-poker:error',
          {
            message:
              '荳肴ｭ｣縺ｪ繧｢繧ｯ繧ｷ繝ｧ繝ｳ縺ｧ縺吶・,
          }
        );
      }
    );


    // ========================================================
    // 譛蠕後・蝗樒ｭ・
    // ========================================================

    socket.on(
      'extra-poker:last-answer',
      async (payload) => {
        const roomId =
          String(
            payload?.roomId ||
              ''
          )
            .replace(
              /\D/g,
              ''
            )
            .slice(
              0,
              4
            );

        const game =
          extraPokerGames.get(
            roomId
          );

        if (
          !game
        ) {
          return;
        }

        if (
          game.phase !==
          'last-answer'
        ) {
          return;
        }

        if (
          game.currentActorId !==
          socket.id
        ) {
          return;
        }

        const answer =
          String(
            payload?.answer ??
              ''
          ).trim();

        if (
          !answer
        ) {
          socket.emit(
            'extra-poker:error',
            {
              message:
                '繧ｭ繝｣繝ｩ繧ｯ繧ｿ繝ｼ蜷阪ｒ蜈･蜉帙＠縺ｦ縺上□縺輔＞縲・,
            }
          );

          return;
        }

        const correct =
          extraPokerIsCorrectAnswer(
            game,
            answer
          );

        const player =
          extraPokerGetPlayers(
            game
          ).find(
            (item) =>
              item.socketId ===
              socket.id
          );

        for (
          const target of
            extraPokerGetPlayers(
              game
            )
        ) {
          const targetSocket =
            io.sockets.sockets.get(
              target.socketId
            );

          if (
            targetSocket
          ) {
            targetSocket.emit(
              'extra-poker:last-answer-result',
              {
                playerName:
                  player?.name ||
                  '繝励Ξ繧､繝､繝ｼ',

                answer,

                correct,

                characterName:
                  correct
                    ? game.character.name
                    : null,

                description:
                  correct
                    ? String(
                        game.character?.description ?? ''
                      )
                    : null,
              }
            );
          }
        }

        if (
          correct
        ) {
          await extraPokerEndTurn(
            game,
            '譛蠕後・蝗樒ｭ斐〒豁｣隗｣縺励∪縺励◆縲・,
            [
              socket.id,
            ]
          );

          return;
        }

        await extraPokerEndTurn(
          game,
          '譛蠕後・蝗樒ｭ斐ｂ荳肴ｭ｣隗｣縺ｧ縺励◆縲・,
          []
        );
      }
    );


