// ============================================================

async function loadExtraPokerData() {
  try {
    const XLSX = await import('xlsx');

    const workbook =
      XLSX.default?.readFile
        ? XLSX.default
        : XLSX;

    const fs =
      await import('node:fs');

    const path =
      await import('node:path');

    const absolutePath =
      path.join(
        process.cwd(),
        'data',
        'extra.xlsx'
      );

    if (
      !fs.existsSync(
        absolutePath
      )
    ) {
      throw new Error(
        `extra.xlsx 縺瑚ｦ九▽縺九ｊ縺ｾ縺帙ｓ: ${absolutePath}`
      );
    }

    const wb =
      workbook.readFile(
        absolutePath
      );

    const sheetName =
      wb.SheetNames?.[0];

    if (!sheetName) {
      throw new Error(
        'extra.xlsx 縺ｫ繧ｷ繝ｼ繝医′縺ゅｊ縺ｾ縺帙ｓ縲・
      );
    }

    const sheet =
      wb.Sheets[
        sheetName
      ];

    const rows =
      XLSX.utils.sheet_to_json(
        sheet,
        {
          header: 1,
          defval: '',
        }
      );

    const characters = [];

    for (
      let i = 0;
      i < rows.length;
      i += 1
    ) {
      const row =
        rows[i];

      if (
        !Array.isArray(row) ||
        row.length < 2
      ) {
        continue;
      }

      const name =
        String(
          row[0] ?? ''
        ).trim();

      const description =
        String(
          row[1] ?? ''
        ).trim();

      if (
        !name ||
        !description
      ) {
        continue;
      }

      characters.push({
        id:
          `extra-character-${i}`,

        name,

        description,
      });
    }

    if (
      characters.length === 0
    ) {
      throw new Error(
        'extra.xlsx 縺九ｉ繧ｭ繝｣繝ｩ繧ｯ繧ｿ繝ｼ繧定ｪｭ縺ｿ霎ｼ繧√∪縺帙ｓ縺ｧ縺励◆縲・
      );
    }

    return characters;
  } catch (error) {
    console.error(
      '[extra-poker] extra.xlsx 隱ｭ縺ｿ霎ｼ縺ｿ繧ｨ繝ｩ繝ｼ:',
      error
    );

    throw error;
  }
}


