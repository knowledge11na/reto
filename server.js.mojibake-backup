function extraPokerCanAct(
  game,
  socketId
) {
  if (
    game.phase !==
    'playing'
  ) {
    return false;
  }

  if (
    game.currentActorId !==
    socketId
  ) {
    return false;
  }

  if (
    game.folded[
      socketId
    ] ||
    game.answerLost[
      socketId
    ]
  ) {
    return false;
  }

  return true;
}


