function hawkSendMyCards(
  game,
  socket
) {
  if (!socket) {
    return;
  }

  const hand =
    game.hands[
      socket.id
    ];

  if (
    !Array.isArray(hand)
  ) {
    return;
  }

  const publicCards =
    hand
      .map(
        (cardId) =>
          hawkPublicCard(
            game.cardMap[
              cardId
            ]
          )
      )
      .filter(Boolean);

  socket.emit(
    'hawk:my-cards',
    {
      cards:
        publicCards,
    }
  );
}


