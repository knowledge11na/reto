          }

           /*
           * ====================================================
           * 譁ｰ隕丞屓遲斐・蝣ｴ蜷・
           * ====================================================
           */

          if (
            isNewAnswer
          ) {

            for (
              const socketId of
                game.cycleActors
            ) {
              if (
                game.folded[
                  socketId
                ] ||
                game.answerLost[
                  socketId
                ]
              ) {
                game.cycleActed[
                  socketId
                ] = true;

                continue;
              }


              game.cycleActed[
                socketId
              ] =
                socketId ===
                playerSocketId;
            }


            game.cycleActed[
              playerSocketId
            ] = true;

            const canAdvance =
              extraPokerAdvanceActor(
                game
              );

            if (
              canAdvance
            ) {
              extraPokerBroadcastState(
                game
              );

              return;
            }
          }

          /*
           * ====================================================
           * 繝ｬ繧､繧ｺ縺ｮ蝣ｴ蜷・
           * ====================================================
           *
           * 譁ｰ縺励＞譛鬮倬｡阪↓螻翫＞縺ｦ縺・↑縺・ｺｺ縺後＞繧九↑繧・
           * 縺昴・莠ｺ縺ｸ謇狗分繧貞屓縺吶・
           */
          if (
            raisesCurrentBet
          ) {
            const canAdvance =
              extraPokerAdvanceActor(
                game
              );

            if (
              canAdvance
            ) {
              extraPokerBroadcastState(
                game
              );

              return;
            }
          }

          /*
           * ====================================================
           * 縺薙％縺ｾ縺ｧ譚･縺溷ｴ蜷・
           * ====================================================
           *
           * 繧ゅ≧霑ｽ蜉縺ｧ蝗槭☆蠢・ｦ√′縺ｪ縺・・
           *
           * 蜈ｨ蜩｡縺悟ｿ・ｦ√↑陦悟虚繧堤ｵゅ∴縺ｦ縺・ｋ縺ｪ繧・
           * 蝗樒ｭ斐ヵ繧ｧ繝ｼ繧ｺ縺ｸ縲・
           */
          if (
            extraPokerCycleComplete(
              game
            )
          ) {
            await extraPokerFinishCycle(
              game
            );

            return;
          }

          /*
           * 蠢ｵ縺ｮ縺溘ａ縲√∪縺陦悟虚縺励※縺・↑縺・・繝ｬ繧､繝､繝ｼ縺・
           * 蟄伜惠縺吶ｋ蝣ｴ蜷医・謇狗分繧帝ｲ繧√ｋ縲・
           */
          const canAdvance =
            extraPokerAdvanceActor(
              game
            );

          if (
            canAdvance
          ) {
            extraPokerBroadcastState(
              game
            );

            return;
          }

          /*
           * 譛邨ら噪縺ｫ繧ｵ繧､繧ｯ繝ｫ縺悟ｮ御ｺ・＠縺ｦ縺・ｋ縺ｪ繧・
           * 蝗樒ｭ斐ヵ繧ｧ繝ｼ繧ｺ縺ｸ縲・
           */
          if (
            extraPokerCycleComplete(
              game
            )
          ) {
            await extraPokerFinishCycle(
              game
            );

            return;
          }

          extraPokerBroadcastState(
            game
          );

          return;
        }

        // ======================================================
        // RAISE
        // ======================================================

        if (
          action ===
          'raise'
