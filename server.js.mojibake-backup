          players.length > 0 &&
          players.every(
            (player) =>
              Boolean(
                game.played[
                  player.socketId
                ]
              )
          );

        console.log(
          '[hawk:play-card] SUBMISSION CHECK',
          {
            roomId,
            playerCount:
              players.length,
            playedCount:
              Object.keys(
                game.played || {}
              ).length,
            allSubmitted,
