// ============================================================
// 逵区攸縺溘〓縺搾ｼ壼・譛溯ｳ・ｺ蝉ｸ企剞
// ============================================================

const SAIKORO_INITIAL_MAX_RESOURCES = {
  berry:
    12,

  verse:
    6,

  eternal:
    6,
};


// ============================================================
// 逵区攸縺溘〓縺搾ｼ壼・譛溘・繝ｪ繝ｼ
// ============================================================

function saikoroInitialBerry(
  playerNumber
) {
  const number =
    Number(
      playerNumber
    );

  if (
    number === 1
  ) {
    return 3;
  }

  if (
    number === 2
  ) {
    return 2;
  }

  if (
    number === 3
  ) {
    return 1;
  }

  return 0;
}


// ============================================================
// 逵区攸縺溘〓縺搾ｼ壹す繝｣繝・ヵ繝ｫ
// ============================================================

function saikoroShuffle(
  array
) {
  const result =
    [
      ...array,
    ];

  for (
    let i =
      result.length - 1;
    i > 0;
    i -= 1
  ) {
    const j =
      Math.floor(
        Math.random() *
          (i + 1)
      );

    [
      result[i],
      result[j],
    ] = [
      result[j],
      result[i],
    ];
  }

  return result;
}


// ============================================================
// 逵区攸縺溘〓縺搾ｼ夐Κ螻九・繝ｬ繧､繝､繝ｼ蜿門ｾ・
// ============================================================

function saikoroGetPlayers(
  game
) {
  const room =
    freeRooms.get(
      game.roomId
    );

  if (
    !room
  ) {
    return [];
  }

  if (
    room.players instanceof
    Map
  ) {
    return Array.from(
      room.players.values()
    );
  }

  if (
    Array.isArray(
      room.players
    )
  ) {
    return room.players;
  }

  return [];
}


// ============================================================
// 逵区攸縺溘〓縺搾ｼ壹ご繝ｼ繝繝励Ξ繧､繝､繝ｼ諠・ｱ蜿門ｾ・
// ============================================================

function saikoroGetGamePlayer(
  game,
  socketId
) {
  if (
    !game ||
    !socketId
  ) {
    return null;
  }

  return (
    game.players?.[
      socketId
    ] ||
    null
  );
}


// ============================================================
// 逵区攸縺溘〓縺搾ｼ夊ｳ・ｺ舌ｒ荳企剞蜀・〒蜉邂・
// ============================================================

function saikoroAddResource(
  player,
  type,
  amount
) {
  if (
    !player ||
    !player.resources ||
    !player.maxResources
  ) {
    return 0;
  }

  if (
    ![
      'berry',
      'verse',
      'eternal',
    ].includes(
      type
    )
  ) {
    return 0;
  }

  const add =
    Math.max(
      0,
      Number(amount) || 0
    );

  const before =
    Number(
      player.resources[
        type
      ] ?? 0
    );

  const max =
    Number(
      player.maxResources[
        type
      ] ?? 0
    );

  const after =
    Math.min(
      max,
      before + add
    );

  player.resources[
    type
  ] = after;

  return (
    after -
    before
  );
}


// ============================================================
// 逵区攸縺溘〓縺搾ｼ壹ム繧､繧ｹ1蛟九ｒ謖ｯ繧・
// ============================================================

function saikoroRollOneDie(
  faces
) {
  if (
    !Array.isArray(
      faces
    ) ||
    faces.length === 0
  ) {
    return null;
  }

  const index =
    Math.floor(
      Math.random() *
        faces.length
    );

  const face =
    faces[index];

  return {
    index,

    face: {
      ...face,
    },
  };
}


// ============================================================
// 逵区攸縺溘〓縺搾ｼ・莠ｺ蛻・・繝繧､繧ｹ繧呈険繧・
// ============================================================

function saikoroRollPlayerDice(
  player
) {
  const result = {
    a:
      saikoroRollOneDie(
        player.diceA
      ),

    b:
      saikoroRollOneDie(
        player.diceB
      ),
  };

  return result;
}


// ============================================================
// 逵区攸縺溘〓縺搾ｼ壹ム繧､繧ｹ邨先棡縺九ｉ雉・ｺ舌ｒ迯ｲ蠕・
// ============================================================

function saikoroApplyDiceResult(
  player,
  result
) {
  if (
    !player ||
    !result
  ) {
    return;
  }

  const results = [
    result.a,
    result.b,
  ];

  for (
    const item of results
  ) {
    if (
      !item?.face
    ) {
      continue;
    }

    const type =
      item.face.type;

    const value =
      Number(
        item.face.value
      ) || 0;

    if (
      type ===
      'berry'
    ) {
      saikoroAddResource(
        player,
        'berry',
        value
      );
    }

    if (
      type ===
      'verse'
    ) {
      saikoroAddResource(
        player,
        'verse',
        value
      );
    }

    if (
      type ===
      'eternal'
    ) {
      saikoroAddResource(
        player,
        'eternal',
        value
      );
    }
  }
}


// ============================================================
// 逵区攸縺溘〓縺搾ｼ壼・髢狗畑繝励Ξ繧､繝､繝ｼ諠・ｱ
// ============================================================

function saikoroPublicPlayer(game, player, index) {
if (!player) {
return null;
}

const gamePlayer = game.players?.[player.socketId];

const seat = Number.isInteger(gamePlayer?.seat)
? gamePlayer.seat
: index;

if (!gamePlayer) {
return {
seat,
id: player.userId ?? null,
name: player.name || `繝励Ξ繧､繝､繝ｼ${seat + 1}`,
resources: {
berry: 0,
verse: 0,
eternal: 0,
},
maxResources: {
...SAIKORO_INITIAL_MAX_RESOURCES,
},
diceA: SAIKORO_INITIAL_DICE_A.map((face) => ({ ...face })),
diceB: SAIKORO_INITIAL_DICE_B.map((face) => ({ ...face })),
cards: [],
extraCharacterInfo: [],
vivreCardInfo: [],
extraCharacterCount: 0,
vivreCardCount: 0,
};
}

return {
seat,
id: player.userId ?? null,
name: player.name || `繝励Ξ繧､繝､繝ｼ${seat + 1}`,
resources: {
berry: Number(gamePlayer.resources?.berry ?? 0),
verse: Number(gamePlayer.resources?.verse ?? 0),
eternal: Number(gamePlayer.resources?.eternal ?? 0),
},
maxResources: {
...gamePlayer.maxResources,
},
diceA: gamePlayer.diceA.map((face) => ({ ...face })),
diceB: gamePlayer.diceB.map((face) => ({ ...face })),
cards: gamePlayer.cards.map((card) => ({ ...card })),
extraCharacterInfo: [...gamePlayer.extraCharacterInfo],
vivreCardInfo: [...gamePlayer.vivreCardInfo],
extraCharacterCount: Number(gamePlayer.extraCharacterCount ?? 0),
vivreCardCount: Number(gamePlayer.vivreCardCount ?? 0),
};
}


// ============================================================
// 逵区攸縺溘〓縺搾ｼ夂樟蝨ｨ縺ｮ迥ｶ諷九ｒ菴懊ｋ
// ============================================================

function saikoroBuildState(
  game
) {
  const players =
    saikoroGetPlayers(
      game
    );

  return {
    roomId:
      game.roomId,

    phase:
      game.phase,

    turnPlayer:
      Number(
        game.turnPlayer ??
          0
      ),

    round:
      Number(
        game.round ??
          1
      ),


players:
  players.map(
    (player, index) =>
      saikoroPublicPlayer(
        game,
        player,
        index
      )
  ),



    diceResults:
      game.diceResults || {},

    actionUsed:
      game.actionUsed || {},

    extraActionUsed:
      game.extraActionUsed ||
      {},

    answerTarget:
      game.answerTarget ||
      null,

    message:
      game.message ||
      '',
  };
}


// ============================================================
// 逵区攸縺溘〓縺搾ｼ夂憾諷九ｒ蜈ｨ蜩｡縺ｸ騾∽ｿ｡
// ============================================================

function saikoroBroadcastState(
  game
) {
  const players =
    saikoroGetPlayers(
      game
    );

  if (
    !players.length
  ) {
    return;
  }

  const state =
    saikoroBuildState(
      game
    );

  for (
    const player of players
  ) {
    const targetSocket =
      io.sockets.sockets.get(
        player.socketId
      );

    if (
      !targetSocket
    ) {
      continue;
    }

    targetSocket.emit(
      'saikoro:state',
      state
    );
  }
}


// ============================================================
// 逵区攸縺溘〓縺搾ｼ壹お繝ｩ繝ｼ騾∽ｿ｡
