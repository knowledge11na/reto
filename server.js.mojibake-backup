function extraPokerFinishGame(
  game
) {
  game.phase =
    'finished';

  const results =
    extraPokerBuildFinalResults(
      game
    );

  const players =
    extraPokerGetPlayers(
      game
    );

  for (
    const player of players
  ) {
    const targetSocket =
      io.sockets.sockets.get(
        player.socketId
      );

    if (
      targetSocket
    ) {
      targetSocket.emit(
        'extra-poker:game-finished',
        {
          results,
        }
      );
    }
  }

  extraPokerBroadcastState(
    game
  );
}


