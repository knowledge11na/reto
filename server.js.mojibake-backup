// 繧ｲ繝ｼ繝譛邨らｵ先棡
// ============================================================

function extraPokerBuildFinalResults(
  game
) {
  const players =
    extraPokerGetPlayers(
      game
    );

  return players
    .map(
      (player) => ({
        socketId:
          player.socketId,

        name:
          player.name ||
          '繝励Ξ繧､繝､繝ｼ',

        chips:
          Number(
            game.chips[
              player.socketId
            ] ?? 0
          ),
      })
    )
    .sort(
      (a, b) =>
        b.chips -
        a.chips
    )
    .map(
      (
        player,
        index
      ) => ({
        ...player,

        rank:
          index + 1,
      })
    );
}


