    players.length === 0
  ) {
    return null;
  }

  const randomIndex =
    Math.floor(
      Math.random() *
        players.length
    );

  return players[
    randomIndex
  ].socketId;
}


// ============================================================
// 譎りｨ亥屓繧翫・谺｡繝励Ξ繧､繝､繝ｼ
// ============================================================

function extraPokerNextPlayer(
  game,
  socketId,
  options = {}
) {
  const includeFolded =
    options.includeFolded === true;

  const players =
    extraPokerGetActivePlayers(
      game
    );

  if (
    players.length === 0
  ) {
    return null;
  }

  /*
   * 蠎ｧ蟶ｭ鬆・・縲継layers縲阪・鬆・分繧貞渕貅悶↓縺吶ｋ縲・
   *
   * 驥崎ｦ・
   * 繝輔か繝ｼ繝ｫ繝峨＠縺滉ｺｺ繧貞・縺ｫ驟榊・縺九ｉ豸医＠縺ｦ縺励∪縺・→縲・
   *
   * A 竊・B 竊・C 竊・D
   *
   * 縺ｧB縺後ヵ繧ｩ繝ｼ繝ｫ繝峨＠縺溘→縺阪・
   * 縲沓縺ｮ谺｡縲阪ｒ謗｢縺帙↑縺上↑縺｣縺ｦA縺ｫ謌ｻ縺｣縺ｦ縺励∪縺・・
   *
   * 縺昴・縺溘ａ縲√∪縺壼・縺ｮ蠎ｧ蟶ｭ鬆・°繧・
   * 迴ｾ蝨ｨ菴咲ｽｮ繧呈爾縺励※縲√◎縺ｮ蠕後ｍ縺九ｉ
   * 逕溷ｭ倥＠縺ｦ縺・ｋ繝励Ξ繧､繝､繝ｼ繧呈爾縺吶・
   */

  const currentIndex =
    players.findIndex(
      (player) =>
        player.socketId ===
        socketId
    );

  /*
   * 迴ｾ蝨ｨ縺ｮ繝励Ξ繧､繝､繝ｼ縺・
   * players縺ｫ蟄伜惠縺励↑縺・ｴ蜷医・
   *
   * 縺薙ｌ縺ｯ繧ｲ繝ｼ繝髢句ｧ区凾縺ｪ縺ｩ縺ｫ襍ｷ縺薙ｊ蠕励ｋ縺ｮ縺ｧ縲・
   * 逕溷ｭ倥＠縺ｦ縺・ｋ繝励Ξ繧､繝､繝ｼ縺ｮ蜈磯ｭ繧定ｿ斐☆縲・
   */
  if (
    currentIndex < 0
  ) {
    const usable =
      players.filter(
        (player) =>
          includeFolded ||
          (
            !game.folded[
              player.socketId
            ] &&
            !game.answerLost[
              player.socketId
            ]
          )
      );

    return (
      usable[0]?.socketId ??
      null
    );
  }

  /*
   * 迴ｾ蝨ｨ繝励Ξ繧､繝､繝ｼ縺ｮ谺｡縺ｮ蠎ｧ蟶ｭ縺九ｉ
   * 譎りｨ亥屓繧翫↓謗｢縺吶・
   *
   * 閾ｪ蛻・・霄ｫ縺ｯ霑斐＆縺ｪ縺・・
   */
  for (
    let i = 1;
    i <= players.length;
    i += 1
  ) {
    const player =
      players[
        (
          currentIndex + i
        ) %
          players.length
      ];

    if (
      includeFolded ||
      (
        !game.folded[
          player.socketId
        ] &&
        !game.answerLost[
          player.socketId
        ]
      )
    ) {
      return player.socketId;
    }
  }

  return null;
}

// ============================================================
// 鬆・分繧剃ｽ懊ｋ
// ============================================================

function extraPokerBuildCycle(
  game,
  firstSocketId
) {
  const players =
    extraPokerGetActivePlayers(
      game
    ).filter(
      (player) =>
        !game.folded[
          player.socketId
        ] &&
        !game.answerLost[
          player.socketId
        ]
    );

  if (
    players.length === 0
  ) {
    return [];
  }

  const index =
    players.findIndex(
      (player) =>
        player.socketId ===
        firstSocketId
    );

  if (
    index < 0
  ) {
    return players.map(
      (player) =>
        player.socketId
    );
  }

  const result = [];

  for (
    let i = 0;
    i < players.length;
    i += 1
  ) {
    result.push(
      players[
        (
          index + i
        ) %
          players.length
      ].socketId
    );
  }

  return result;
}


